# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=your_openai_api_key_here

# Optional settings (defaults shown)
# OPENAI_CHAT_MODEL=gpt-5.5
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# LLM_TEMPERATURE=            # empty = model default; GPT-5.x reasoning models need it empty
# LLM_MAX_TOKENS=1500
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# TOP_K=4
# AGENT_MAX_TOOL_ROUNDS=4
# MAX_URLS=10
# FETCH_TIMEOUT_SECONDS=20
# INDEX_DIR=data/faiss_index
# LOG_DIR=logs
# NEWS_RESEARCH_API_URL=http://127.0.0.1:8000   # used by the Streamlit frontend

# Optional LangSmith tracing of every agent step
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGSMITH_PROJECT=news-research-agent
